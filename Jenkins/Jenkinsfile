node {
    // Define parameters
    properties([
        parameters([
            choice(
                name: 'ACTION',
                choices: ['connect', 'apply', 'status'],
                description: 'Choose which action to perform'
            ),
            string(
                name: 'NAMESPACE',
                defaultValue: 'keda-app',
                description: 'Kubernetes namespace (only needed for apply/status)'
            )
        ])
    ])

    def scriptPath = './simplismart.sh'

    stage('Checkout Code') {
        // Replace with your repo URL
        git url: 'https://github.com/MJ1608/Assignment_Simplismart.git'
    }

    stage('Make Script Executable') {
        sh "chmod +x ${scriptPath}"
    }

    stage('Validate Input') {
        if ((params.ACTION == 'apply' || params.ACTION == 'status') && params.NAMESPACE.trim() == '') {
            error "Namespace must not be empty for action '${params.ACTION}'"
        }
    }

    stage('Run Action') {
        if (params.ACTION == 'connect') {
            sh "${scriptPath} connect"
        } else if (params.ACTION == 'apply') {
            sh "${scriptPath} -n ${params.NAMESPACE} apply"
        } else if (params.ACTION == 'status') {
            sh "${scriptPath} -n ${params.NAMESPACE} status"
        } else {
            error "Unknown action: ${params.ACTION}"
        }
    }

    stage('Post Result') {
        echo "✅ Action '${params.ACTION}' completed."
    }
}

